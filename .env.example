# Адрес шлюза для браузера. В compose — http://localhost:8080.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Сборка SubwaySurf для плеера (контейнер subwaysurf в compose).
# Пусто — плеера нет, страница игры показывает конфиг.
NEXT_PUBLIC_GAME_URL=http://localhost:8081

# База S3/CDN для относительных путей спрайтов из конфига игры.
# Пусто — игра грузит встроенные спрайты от своего origin.
NEXT_PUBLIC_SPRITE_BASE_URL=
